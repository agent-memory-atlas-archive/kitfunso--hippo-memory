---
// Brand wordmark: the Spiral mark (a hippocampus curl drawn with memories) + "hippo".
// Dots come from scripts/make-logo.mjs; mint = recalled, dim = fading, amber = marked wrong.
import dots from '../content/logo-mark.json';
---

<span class="inline-flex items-center gap-2.5 font-display text-base font-medium tracking-tight">
  <svg width="28" height="28" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
    <rect width="64" height="64" rx="14" fill="#0b0f0c" />
    <rect x="0.5" y="0.5" width="63" height="63" rx="13.5" fill="none" stroke="#e6ede7" stroke-opacity="0.1" />
    {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={d.fill} fill-opacity={d.opacity} />)}
  </svg>
  <span>hippo</span>
</span>
